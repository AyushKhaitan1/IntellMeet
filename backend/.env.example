# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/intellmeet

# Redis Cache (Optional, in-memory cache used if not set)
# REDIS_URL=redis://127.0.0.1:6379

# JWT Authentication
JWT_ACCESS_SECRET=intellmeet_jwt_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=intellmeet_jwt_refresh_secret_super_secure_key_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary (Optional, local uploads folder used if not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Logging
LOG_LEVEL=info
